    "import numpy as np\n",
    "\n",
    "def psd_from_tde_cov(C, fs, nfft=4096):\n",
    "    m = C.shape[0]\n",
    "    r = np.array([np.mean(np.diag(C, k)) for k in range(m)])  # r[0..m-1]\n",
    "    r_full = np.concatenate([r[:0:-1], r])                    # symmetric\n",
    "    S = np.fft.rfft(r_full, n=nfft)\n",
    "    psd = np.real(S)\n",
    "    f = np.fft.rfftfreq(nfft, d=1/fs)\n",
    "    return f, psd\n",
