    "import jax\n",
    "import jax.numpy as jnp\n",
    "from jax import random\n",
    "import numpyro.distributions as dist\n",
    "\n",
    "def sample_covariance_priors(\n",
    "    key: jax.Array,\n",
    "    *,\n",
    "    num_states: int,\n",
    "    num_dim: int,\n",
    "    concentration: float = 1.0,\n",
    "    sigma_scale: float = 1.0,\n",
    "    share_sigma_across_states: bool = False,\n",
    "):\n",
    "    \"\"\"\n",
    "    Sample K covariance matrices outside a NumPyro model using:\n",
    "      L_corr ~ LKJCholesky(D, concentration)\n",
    "      sigma  ~ HalfCauchy(sigma_scale)   (scalar per component => constant diag)\n",
    "      L_cov  = sigma * L_corr\n",
    "      cov    = L_cov @ L_cov.T\n",
    "\n",
    "    Returns:\n",
    "      covs   (K, D, D)\n",
    "      L_covs (K, D, D)  scale_tril\n",
    "      sigmas (K,)\n",
    "      L_corr (K, D, D)\n",
    "    \"\"\"\n",
    "    key_sigma, key_corr = random.split(key, 2)\n",
    "\n",
    "    # --- sample sigmas ---\n",
    "    if share_sigma_across_states:\n",
    "        sigma = dist.HalfCauchy(sigma_scale).sample(key_sigma)          # ()\n",
    "        sigmas = jnp.repeat(sigma[None], num_states, axis=0)            # (K,)\n",
    "    else:\n",
    "        sigmas = dist.HalfCauchy(sigma_scale).sample(\n",
