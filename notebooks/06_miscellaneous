    "def peakiness(f, psd, fmin=5, fmax=60):\n",
    "    mask = (f>=fmin) & (f<=fmax)\n",
    "    p = psd[mask]\n",
    "    return float(p.max() / (p.mean() + 1e-12)), float(f[mask][np.argmax(p)])\n"
   ]
